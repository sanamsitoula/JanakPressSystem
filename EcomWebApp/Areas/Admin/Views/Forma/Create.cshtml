@model Ecom.WebApp.Areas.Admin.ViewModels.FormaViewModel.FormaFormViewModel
<div class="card shadow border-0 my-4">
    <div class="card-header  ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-bg-light py-2">Create Forma</h2>
            </div>
        </div>
        <div class="card-body p-4">
            <form method="post" class="row">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="border p-4 mt-3 rounded">
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Enter Name" required />
                        <label asp-for="Name"></label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Page" type="number" class="form-control" placeholder="Enter Page" />
                        <label asp-for="Page"></label>
                        <span asp-validation-for="Page" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="PrintTarget" type="number" class="form-control" placeholder="Enter Print Target" />
                        <label asp-for="PrintTarget"></label>
                        <span asp-validation-for="PrintTarget" class="text-danger"></span>
                    </div>

                    @* <div class="form-floating mb-3"> *@
                    @*     <input asp-for="PrintAchieved" type="number" class="form-control" placeholder="Enter Print Achieved" /> *@
                    @*     <label asp-for="PrintAchieved"></label> *@
                    @*     <span asp-validation-for="PrintAchieved" class="text-danger"></span> *@
                    @* </div> *@

                    <div class="form-floating mb-3">
                        <input asp-for="AssociatedForma" class="form-control" placeholder="Enter Associated Forma" />
                        <label asp-for="AssociatedForma"></label>
                        <span asp-validation-for="AssociatedForma" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Remarks" class="form-control" placeholder="Enter Remarks" />
                        <label asp-for="Remarks"></label>
                        <span asp-validation-for="Remarks" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product" class="form-label"></label>
                        <select asp-for="Product" class="form-select" asp-items="ViewBag.productlist" required>
                            <option value="">Please Choose your Product</option>
                        </select>
                        <span asp-validation-for="Product" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Code" class="form-control" placeholder="Enter Code" />
                        <label asp-for="Code"></label>
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>

                    @* <div class="form-check mb-3"> *@
                    @*     <input asp-for="Status" class="form-check-input" type="checkbox" id="statusCheck"> *@
                    @*     <label class="form-check-label" for="statusCheck">@Html.DisplayNameFor(model => model.Status)</label> *@
                    @*     <span asp-validation-for="Status" class="text-danger"></span> *@
                    @* </div> *@

                    <div class="row mt-3">
                        <div class="col-md-3 col-6">
                            <button type="submit" class="btn btn-primary w-100">Create</button>
                        </div>
                        <div class="col-md-3 col-6">
                            <a asp-controller="Forma" asp-action="Index" class="btn btn-secondary w-100">Back to List</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>


    </div>
</div>

@section Scripts {

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}